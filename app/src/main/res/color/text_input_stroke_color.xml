<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true" android:color="#4CAF50" />
    <!-- Error state -->
    <item android:state_activated="true" android:color="#F44336" />
    <!-- Hovered state -->
    <item android:state_hovered="true" android:color="#66BB6A" />
    <!-- Default state -->
    <item android:color="#80FFFFFF" />
</selector>