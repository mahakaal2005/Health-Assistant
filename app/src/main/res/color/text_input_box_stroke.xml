<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state - use the app's primary teal color -->
    <item android:color="@color/colorPrimary" android:state_focused="true" />
    <!-- Error state - amber yellow for good contrast against dark background -->
    <item android:color="#FFE57F" android:state_activated="true" />
    <!-- Default state - semi-transparent white -->
    <item android:color="#B3FFFFFF" /> <!-- 70% white -->
</selector>