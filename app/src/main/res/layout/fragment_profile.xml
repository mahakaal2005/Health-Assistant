<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".features.profile.ProfileFragment">

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:background="@android:color/transparent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="24dp">

            <!-- Standardized Profile Header Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_header_section"
                style="@style/Widget.HealthAssistant.FragmentHeader"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Profile Title -->
                <TextView
                    android:id="@+id/profile_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textAppearance="@style/TextAppearance.HealthAssistant.FragmentTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Profile Subtitle -->
                <TextView
                    android:id="@+id/profile_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage your health profile"
                    android:textAppearance="@style/TextAppearance.HealthAssistant.FragmentSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/profile_title" />

                <!-- Welcome/Intro Text (moved below header) -->
                <TextView
                    android:id="@+id/profileIntroText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Buddy!!"
                    android:textSize="20sp"
                    android:textColor="@color/ds_text_primary"
                    android:textStyle="bold|italic"
                    android:fontFamily="serif"
                    android:alpha="0.95"
                    android:layout_marginTop="@dimen/ds_margin_standard"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/profile_subtitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:elevation="2dp" />

                <!-- Avatar with Edit Option -->
                <FrameLayout
                    android:id="@+id/avatar_container"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:elevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/profileIntroText"
                    android:layout_marginTop="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profile_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="View profile photo in full screen"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:civ_border_color="@color/health_primary"
                        app:civ_border_width="3dp" />

                </FrameLayout>

                <!-- User Name -->
                <TextView
                    android:id="@+id/user_full_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Alex Johnson"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:elevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/avatar_container" />

                <!-- Bio Text - Now editable in EditProfileFragment -->
                <TextView
                    android:id="@+id/user_bio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="32dp"
                    android:gravity="center"
                    android:text="Add your bio in Edit Profile"
                    android:textSize="14sp"
                    android:textColor="@color/textPrimary"
                    android:alpha="0.9"
                    android:minHeight="40dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_full_name" />

                <!-- Edit Profile Button -->
                <Button
                    android:id="@+id/edit_profile_button"
                    style="@style/Widget.HealthAssistant.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Edit Profile"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/user_bio" />
            </androidx.constraintlayout.widget.ConstraintLayout>







            <!-- Prescriptions Button -->
            <Button
                android:id="@+id/prescriptions_button"
                style="@style/Widget.HealthAssistant.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="16dp"
                android:drawableStart="@android:drawable/ic_menu_agenda"
                android:drawableTint="#FFFFFF"
                android:text="Prescriptions"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_header_section" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/logoutButton"
                style="@style/Widget.HealthAssistant.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:drawableTint="#FFFFFF"
                android:text="Logout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/prescriptions_button"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>