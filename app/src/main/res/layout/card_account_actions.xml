<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/account_actions_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/content_padding_medium"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/corner_radius_large"
    app:cardElevation="@dimen/card_elevation_small">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glassmorphism_card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/content_padding_medium">

            <!-- Section Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:text="@string/account_actions"
                style="@style/TextAppearance.HealthAssistant.SectionTitle" />

            <!-- Switch Account -->
            <LinearLayout
                android:id="@+id/switch_account_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/content_padding_medium">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/content_padding_medium"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="@color/colorPrimaryGradientStart" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Switch Account"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/textSecondary" />
            </LinearLayout>

            <!-- Clear Cache -->
            <LinearLayout
                android:id="@+id/clear_cache_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/content_padding_medium">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/content_padding_medium"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="@color/colorPrimaryGradientEnd" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Clear App Cache"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/cache_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 MB"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/content_padding_small"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:background="@color/glassHighlight" />

            <!-- Logout -->
            <Button
                android:id="@+id/logout_button"
                style="@style/Widget.HealthAssistant.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_padding_small"
                android:layout_marginBottom="@dimen/content_padding_small"
                android:text="Log Out"
                android:drawableStart="@android:drawable/ic_lock_power_off"
                android:drawableTint="#FFFFFF" />

            <!-- Delete Account (Danger) -->
            <Button
                android:id="@+id/delete_account_button"
                style="@style/Widget.HealthAssistant.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Account"
                android:drawableStart="@android:drawable/ic_menu_delete"
                android:drawableTint="#FFFFFF" />

        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>