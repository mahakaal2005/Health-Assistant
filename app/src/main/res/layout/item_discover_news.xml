<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/content_padding_small"
    app:cardCornerRadius="@dimen/corner_radius_medium"
    app:cardElevation="@dimen/card_elevation_small"
    app:cardBackgroundColor="@color/cardBackground"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/content_padding_medium">

        <!-- Breaking News Badge -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipBreakingNews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BREAKING"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            android:visibility="gone"
            app:chipBackgroundColor="@color/error"
            app:chipCornerRadius="@dimen/chip_corner_radius"
            app:chipStrokeWidth="0dp"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!-- News Image -->
        <ImageView
            android:id="@+id/imageNews"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="@dimen/content_padding_small"
            android:scaleType="centerCrop"
            android:background="@drawable/card_light_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipBreakingNews"
            tools:src="@drawable/ic_heart" />

        <!-- News Headline -->
        <TextView
            android:id="@+id/textNewsHeadline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_medium"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageNews"
            tools:text="New Study Reveals Breakthrough in Heart Disease Prevention" />

        <!-- News Summary -->
        <TextView
            android:id="@+id/textNewsSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_small"
            android:textSize="@dimen/text_size_body"
            android:textColor="@color/textSecondary"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textNewsHeadline"
            tools:text="Researchers have discovered a new approach to preventing cardiovascular disease that could save millions of lives worldwide." />

        <!-- Source and Date -->
        <TextView
            android:id="@+id/textNewsSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_medium"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/textTertiary"
            app:layout_constraintEnd_toStartOf="@id/textNewsDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textNewsSummary"
            tools:text="Medical Journal Today" />

        <TextView
            android:id="@+id/textNewsDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_medium"
            android:textSize="@dimen/text_size_caption"
            android:textColor="@color/textTertiary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textNewsSummary"
            tools:text="2 hours ago" />

        <!-- Category and Credibility -->
        <LinearLayout
            android:id="@+id/layoutNewsInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_medium"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textNewsSource">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNewsCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_caption"
                app:chipBackgroundColor="@color/colorChip"
                app:chipCornerRadius="@dimen/chip_corner_radius"
                app:chipStrokeWidth="0dp"
                tools:text="Medical Research" />

            <LinearLayout
                android:id="@+id/layoutNewsCredibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_padding_small"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_verified"
                    android:tint="@color/success"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/textNewsCredibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_caption"
                    android:textColor="@color/success"
                    tools:text="Peer-Reviewed" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_padding_medium"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutNewsInfo">

            <ImageButton
                android:id="@+id/buttonNewsShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:tint="@color/textSecondary"
                android:contentDescription="Share news" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>