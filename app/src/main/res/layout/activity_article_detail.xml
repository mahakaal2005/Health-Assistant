<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:contentScrim="@color/ds_primary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <ImageView
                android:id="@+id/article_header_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                tools:src="@drawable/ic_heart" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ds_padding_standard">

            <!-- Article Title -->
            <TextView
                android:id="@+id/article_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_margin_standard"
                android:textAppearance="@style/TextAppearance.HealthTypography.Title.Large"
                android:accessibilityHeading="true"
                android:contentDescription="Article title"
                tools:text="Understanding Heart Health: A Complete Guide" />

            <!-- Article Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_margin_standard"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/article_author"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium"
                    tools:text="Dr. Sarah Johnson" />

                <TextView
                    android:id="@+id/article_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_margin_medium"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium"
                    tools:text="Jan 15, 2025" />

                <TextView
                    android:id="@+id/reading_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_margin_medium"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                    tools:text="5 min read" />

            </LinearLayout>

            <!-- Article Category -->
            <com.google.android.material.chip.Chip
                android:id="@+id/article_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_margin_large"
                android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                app:chipBackgroundColor="@color/colorChip"
                app:chipCornerRadius="@dimen/ds_component_card_radius_small"
                app:chipStrokeWidth="0dp"
                tools:text="Nutrition" />

            <!-- Article Content -->
            <TextView
                android:id="@+id/article_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_margin_large"
                android:textAppearance="@style/TextAppearance.HealthTypography.Body.Medium"
                android:lineSpacingExtra="@dimen/ds_text_line_spacing_medium"
                tools:text="This is the main article content. It provides detailed information about heart health, including tips for maintaining cardiovascular wellness through proper diet, exercise, and lifestyle choices." />

            <!-- Article Tags -->
            <TextView
                android:id="@+id/tags_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_margin_small"
                android:text="Tags:"
                android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/article_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_margin_large"
                app:chipSpacing="@dimen/ds_margin_small">

                <!-- Tags will be added programmatically -->
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="heart health"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                    app:chipBackgroundColor="@color/ds_surface_secondary"
                    app:chipCornerRadius="@dimen/ds_component_card_radius_small"
                    app:chipStrokeWidth="0dp"
                    tools:visibility="visible" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="cardiovascular"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                    app:chipBackgroundColor="@color/ds_surface_secondary"
                    app:chipCornerRadius="@dimen/ds_component_card_radius_small"
                    app:chipStrokeWidth="0dp"
                    tools:visibility="visible" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_bookmark"
                    style="@style/Widget.HealthAssistant.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/ds_margin_small"
                    android:text="Bookmark"
                    app:icon="@drawable/ic_bookmark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_share"
                    style="@style/Widget.HealthAssistant.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/ds_margin_small"
                    android:text="Share"
                    app:icon="@drawable/ic_share" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>