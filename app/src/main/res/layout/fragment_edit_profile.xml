<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Dynamic Gradient Background -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/premium_gradient_background" />

        <!-- Decorative Shape -->
        <View
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-100dp"
            android:layout_marginEnd="-100dp"
            android:alpha="0.2"
            android:background="@drawable/decorative_circle_shape" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Enhanced Toolbar with Save Action -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Edit Profile"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Save Button in Toolbar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/toolbar_save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="Save"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:minWidth="64dp"
                android:enabled="false"
                style="@style/Widget.Material3.Button.TextButton"
                app:strokeColor="@android:color/white"
                app:strokeWidth="1dp" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Progress Overlay -->
        <FrameLayout
            android:id="@+id/progress_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/glassmorphism_card_background"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Saving profile..."
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Main Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/content_padding_large"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Profile Avatar Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/content_padding_medium"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/corner_radius_large"
                    app:cardElevation="@dimen/card_elevation_small">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glassmorphism_card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/content_padding_medium"
                            android:gravity="center">

                            <!-- Profile Image with Upload Indicator -->
                            <FrameLayout
                                android:layout_width="120dp"
                                android:layout_height="120dp">

                                <de.hdodenhof.circleimageview.CircleImageView
                                    android:id="@+id/profile_image_view"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/ic_person"
                                    android:contentDescription="Profile picture - tap to view full size"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                                    app:civ_border_width="3dp"
                                    app:civ_border_color="@color/colorPrimaryGradientStart" />

                                <!-- Upload Progress Indicator -->
                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/photo_upload_progress"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:visibility="gone"
                                    android:indeterminate="true"
                                    app:indicatorColor="@color/colorPrimaryGradientStart" />

                                <!-- Camera Icon Overlay -->
                                <FrameLayout
                                    android:id="@+id/change_photo_button"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="bottom|end"
                                    android:background="@drawable/circle_button_background"
                                    android:elevation="2dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="Change profile picture">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_camera"
                                        android:contentDescription="Change profile picture"
                                        app:tint="@android:color/white" />

                                </FrameLayout>

                            </FrameLayout>


                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Personal Information Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/content_padding_medium"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/corner_radius_large"
                    app:cardElevation="@dimen/card_elevation_small">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glassmorphism_card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/content_padding_medium">

                            <!-- Section Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/content_padding_medium">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_person"
                                    android:contentDescription="Personal information"
                                    app:tint="@color/colorPrimaryGradientStart" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:text="Personal Information"
                                    style="@style/TextAppearance.HealthAssistant.SectionTitle" />

                            </LinearLayout>

                            <!-- Email (Read-only) -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email Address"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/email_text_view"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_readonly_field"
                                android:padding="16dp"
                                android:textSize="16sp"
                                android:textColor="@color/textSecondary"
                                android:layout_marginBottom="@dimen/content_padding_medium"
                                android:drawableStart="@drawable/ic_email"
                                android:drawablePadding="12dp"
                                android:drawableTint="@color/textSecondary"
                                android:contentDescription="Your email address, cannot be changed"
                                tools:text="user@example.com" />

                            <!-- Display Name -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Display Name *"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary"
                                android:layout_marginBottom="4dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/display_name_input_layout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/content_padding_medium"
                                android:hint="Enter your display name"
                                app:boxBackgroundColor="#10FFFFFF"
                                app:boxStrokeColor="@color/colorPrimaryGradientStart"
                                app:hintTextColor="@color/colorPrimaryGradientStart"
                                app:startIconDrawable="@drawable/ic_person"
                                app:startIconTint="@color/colorPrimaryGradientStart"
                                app:helperText="This is how others will see your name"
                                app:helperTextTextColor="@color/textSecondary"
                                app:counterEnabled="true"
                                app:counterMaxLength="50">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/display_name_edit_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPersonName|textCapWords"
                                    android:maxLength="50"
                                    android:textColor="@color/textPrimary"
                                    android:contentDescription="Your display name" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Bio -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bio"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary"
                                android:layout_marginBottom="4dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/bio_input_layout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/content_padding_medium"
                                android:hint="Tell us about yourself"
                                app:boxBackgroundColor="#10FFFFFF"
                                app:boxStrokeColor="@color/colorPrimaryGradientStart"
                                app:hintTextColor="@color/colorPrimaryGradientStart"
                                app:startIconDrawable="@drawable/ic_person"
                                app:startIconTint="@color/colorPrimaryGradientStart"
                                app:helperText="Share your interests, goals, or motivation"
                                app:helperTextTextColor="@color/textSecondary"
                                app:counterEnabled="true"
                                app:counterMaxLength="200">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/bio_edit_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textMultiLine|textCapSentences"
                                    android:maxLength="200"
                                    android:minLines="3"
                                    android:maxLines="5"
                                    android:textColor="@color/textPrimary"
                                    android:contentDescription="Your bio description" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Birthday -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Birthday"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary"
                                android:layout_marginBottom="4dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/birthday_input_layout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/content_padding_medium"
                                android:hint="Select your birthday"
                                app:boxBackgroundColor="#10FFFFFF"
                                app:boxStrokeColor="@color/colorPrimaryGradientStart"
                                app:hintTextColor="@color/colorPrimaryGradientStart"
                                app:startIconDrawable="@drawable/ic_calendar"
                                app:startIconTint="@color/colorPrimaryGradientStart"
                                app:endIconMode="custom"
                                app:endIconDrawable="@drawable/ic_calendar"
                                app:endIconTint="@color/colorPrimaryGradientStart"
                                app:helperText="Optional - helps personalize your experience">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/birthday_edit_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:textColor="@color/textPrimary"
                                    android:contentDescription="Tap to select your birthday" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Gender -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary"
                                android:layout_marginBottom="4dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/gender_input_layout"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Select gender"
                                app:boxBackgroundColor="#10FFFFFF"
                                app:boxStrokeColor="@color/colorPrimaryGradientStart"
                                app:hintTextColor="@color/colorPrimaryGradientStart"
                                app:startIconDrawable="@drawable/ic_person"
                                app:startIconTint="@color/colorPrimaryGradientStart"
                                app:endIconTint="@color/colorPrimaryGradientStart"
                                app:helperText="Optional - helps customize health recommendations">

                                <AutoCompleteTextView
                                    android:id="@+id/gender_dropdown"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:textColor="@color/textPrimary"
                                    android:contentDescription="Select your gender from the dropdown" />

                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- Health Information Section -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/content_padding_medium"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/corner_radius_large"
                    app:cardElevation="@dimen/card_elevation_small">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glassmorphism_card_background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/content_padding_medium">

                            <!-- Section Header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="@dimen/content_padding_medium">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_health_monitoring"
                                    android:contentDescription="Health information"
                                    app:tint="@color/colorPrimaryGradientStart" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="12dp"
                                    android:text="Health Information"
                                    style="@style/TextAppearance.HealthAssistant.SectionTitle" />

                            </LinearLayout>

                            <!-- Height and Weight Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="2"
                                android:baselineAligned="false">

                                <!-- Height Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Height"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/textPrimary"
                                        android:layout_marginBottom="4dp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/height_input_layout"
                                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="cm"
                                        app:boxBackgroundColor="#10FFFFFF"
                                        app:boxStrokeColor="@color/colorPrimaryGradientStart"
                                        app:hintTextColor="@color/colorPrimaryGradientStart"
                                        app:suffixText="cm"
                                        app:suffixTextColor="@color/textSecondary">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/height_edit_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:inputType="numberDecimal"
                                            android:maxLength="5"
                                            android:textColor="@color/textPrimary"
                                            android:contentDescription="Enter your height in centimeters" />

                                    </com.google.android.material.textfield.TextInputLayout>

                                </LinearLayout>

                                <!-- Weight Section -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Weight"
                                        android:textSize="14sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/textPrimary"
                                        android:layout_marginBottom="4dp" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/weight_input_layout"
                                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="kg"
                                        app:boxBackgroundColor="#10FFFFFF"
                                        app:boxStrokeColor="@color/colorPrimaryGradientStart"
                                        app:hintTextColor="@color/colorPrimaryGradientStart"
                                        app:suffixText="kg"
                                        app:suffixTextColor="@color/textSecondary">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/weight_edit_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:inputType="numberDecimal"
                                            android:maxLength="5"
                                            android:textColor="@color/textPrimary"
                                            android:contentDescription="Enter your weight in kilograms" />

                                    </com.google.android.material.textfield.TextInputLayout>

                                </LinearLayout>

                            </LinearLayout>


                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>