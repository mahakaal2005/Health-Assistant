<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/premium_gradient_background"
    tools:context=".features.settings.SettingsFragment">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Settings"
            app:titleTextColor="@color/textPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content - Scrollable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/content_padding_large"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- User Overview Card -->
            <include
                android:id="@+id/user_overview"
                layout="@layout/card_user_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Health Preferences Card -->
            <include
                android:id="@+id/health_preferences"
                layout="@layout/card_health_preferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Notifications Card -->
            <include
                android:id="@+id/notifications"
                layout="@layout/card_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- App Settings Card -->
            <include
                android:id="@+id/app_settings"
                layout="@layout/card_app_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Help & Support Card -->
            <include
                android:id="@+id/help_support"
                layout="@layout/card_help_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Account Actions Card -->
            <include
                android:id="@+id/account_actions"
                layout="@layout/card_account_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>