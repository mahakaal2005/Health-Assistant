<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".features.home.HomeFragment">

    <!-- Dynamic Gradient Background with Decorative Elements -->
    <FrameLayout
        android:id="@+id/dynamic_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/premium_gradient_background" />

        <!-- Decorative Shape 1 - Top Right -->
        <View
            android:id="@+id/decorative_shape_1"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-100dp"
            android:layout_marginEnd="-100dp"
            android:alpha="0.3"
            android:background="@drawable/decorative_circle_shape" />

        <!-- Decorative Shape 2 - Bottom Left -->
        <View
            android:id="@+id/decorative_shape_2"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="-100dp"
            android:layout_marginStart="-100dp"
            android:alpha="0.2"
            android:background="@drawable/decorative_circle_shape" />
    </FrameLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:background="@android:color/transparent"
        android:paddingTop="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="24dp">

            <!-- Top Section with Personalized Greeting and Avatar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Greeting Text Container - Left Aligned -->
                <LinearLayout
                    android:id="@+id/greeting_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@+id/user_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/user_avatar">

                    <!-- Greeting Text with Username Styling -->
                    <TextView
                        android:id="@+id/greeting_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Good morning, Alex"
                        android:textSize="30sp"
                        android:textColor="#000000"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold"
                        android:gravity="start"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:elevation="2dp" />

                    <!-- Date Text -->
                    <TextView
                        android:id="@+id/date_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Saturday, July 12"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:gravity="start"
                        android:elevation="1dp"/>
                </LinearLayout>

                <!-- User Avatar - Right Aligned -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/user_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:contentDescription="View profile photo"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:civ_border_color="#FFFFFF"
                    app:civ_border_width="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Health Summary Card with Glassmorphism Effect -->
            <androidx.cardview.widget.CardView
                android:id="@+id/health_summary_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="-16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/card_elevation_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top_section">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glassmorphism_card_background">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/health_summary_title"
                            style="@style/TextAppearance.HealthAssistant.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health Overview"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Health Metrics Section with Triple-Ring Progress View -->
                        <com.example.health_assistant.widgets.TripleRingProgressView
                            android:id="@+id/triple_ring_progress"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/health_summary_title"
                            app:layout_constraintVertical_bias="0.0" />

                        <!-- Health Metrics Legend -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/metrics_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            app:layout_constraintBottom_toBottomOf="@id/triple_ring_progress"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/triple_ring_progress"
                            app:layout_constraintTop_toTopOf="@id/triple_ring_progress">

                            <!-- Steps Metric -->
                            <ImageView
                                android:id="@+id/steps_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="Steps"
                                android:src="@drawable/ic_steps"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:tint="@color/progress_orange" />

                            <TextView
                                android:id="@+id/steps_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Steps"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toEndOf="@id/steps_icon"
                                app:layout_constraintTop_toTopOf="@id/steps_icon"
                                app:layout_constraintBottom_toBottomOf="@id/steps_icon" />

                            <TextView
                                android:id="@+id/steps_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="0 / 9000 steps"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp"
                                android:layout_marginStart="16dp"
                                app:layout_constraintStart_toStartOf="@id/steps_icon"
                                app:layout_constraintTop_toBottomOf="@id/steps_icon"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <!-- Calories Metric -->
                            <ImageView
                                android:id="@+id/calories_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginTop="16dp"
                                android:contentDescription="Calories"
                                android:src="@drawable/ic_calories"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/steps_value"
                                app:tint="@color/progress_green" />

                            <TextView
                                android:id="@+id/calories_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Calories"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toEndOf="@id/calories_icon"
                                app:layout_constraintTop_toTopOf="@id/calories_icon"
                                app:layout_constraintBottom_toBottomOf="@id/calories_icon" />

                            <TextView
                                android:id="@+id/calories_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="0 / 300 kcal"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp"
                                android:layout_marginStart="16dp"
                                app:layout_constraintStart_toStartOf="@id/calories_icon"
                                app:layout_constraintTop_toBottomOf="@id/calories_icon"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <!-- Heart Points Metric -->
                            <ImageView
                                android:id="@+id/heart_points_icon"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginTop="16dp"
                                android:contentDescription="Heart Points"
                                android:src="@drawable/ic_workout"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/calories_value"
                                app:tint="@color/progress_blue" />

                            <TextView
                                android:id="@+id/heart_points_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Heart Points"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toEndOf="@id/heart_points_icon"
                                app:layout_constraintTop_toTopOf="@id/heart_points_icon"
                                app:layout_constraintBottom_toBottomOf="@id/heart_points_icon" />

                            <TextView
                                android:id="@+id/heart_points_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="0 / 50 points"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp"
                                android:layout_marginStart="16dp"
                                app:layout_constraintStart_toStartOf="@id/heart_points_icon"
                                app:layout_constraintTop_toBottomOf="@id/heart_points_icon"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Wellness Tip Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/contextual_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/card_elevation_small"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/health_summary_card">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glassmorphism_card_background">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/contextual_title"
                            style="@style/TextAppearance.HealthAssistant.SectionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wellness Tip"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@id/contextual_title">


                            <TextView
                                android:id="@+id/contextual_content"
                                style="@style/TextAppearance.HealthAssistant.TipText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Stay hydrated! Aim for 8 glasses of water today." />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- My Progress Section -->
            <TextView
                android:id="@+id/my_progress_title"
                style="@style/TextAppearance.HealthAssistant.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="My Progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contextual_card" />

            <!-- Steps This Week Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/steps_this_week_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/card_elevation_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/my_progress_title">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glassmorphism_card_background">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/steps_chart_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/steps_chart_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Steps This Week"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Steps Summary Row -->
                        <LinearLayout
                            android:id="@+id/steps_summary_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/steps_chart_title">

                            <TextView
                                android:id="@+id/total_steps_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: "
                                android:textSize="14sp"
                                android:textColor="@color/textSecondary" />

                            <TextView
                                android:id="@+id/total_steps_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42,350 steps"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/daily_average_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg: "
                                android:textSize="14sp"
                                android:textColor="@color/textSecondary" />

                            <TextView
                                android:id="@+id/daily_average_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6,050/day"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />

                        </LinearLayout>

                        <!-- Chart Container - Real MPAndroidChart BarChart -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/steps_bar_chart"
                            android:layout_width="0dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/steps_summary_row" />

                        <!-- Weekly Goal Progress -->
                        <LinearLayout
                            android:id="@+id/weekly_goal_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/steps_bar_chart">

                            <TextView
                                android:id="@+id/weekly_goal_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly Goal Progress"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/weekly_goal_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:progress="60"
                                app:indicatorColor="@color/progress_green"
                                app:trackColor="#30FFFFFF"
                                app:trackCornerRadius="4dp" />

                            <TextView
                                android:id="@+id/weekly_goal_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="42,350 / 70,000 steps (60%)"
                                android:textSize="12sp"
                                android:textColor="@color/textSecondary" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Actions Section -->
            <TextView
                android:id="@+id/quick_actions_title"
                style="@style/TextAppearance.HealthAssistant.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Quick Actions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/steps_this_week_card" />

            <!-- Quick Actions as Pill-shaped Floating Action Buttons -->
            <HorizontalScrollView
                android:id="@+id/quick_actions_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quick_actions_title">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <!-- Health Check Pill Button -->
                    <Button
                        android:id="@+id/health_check_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/Widget.HealthAssistant.Button.Primary"
                        android:drawableStart="@android:drawable/ic_menu_help"
                        android:drawableTint="#FFFFFF"
                        android:text="Health Check" />

                    <!-- Prescriptions Pill Button -->
                    <Button
                        android:id="@+id/prescriptions_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/Widget.HealthAssistant.Button.Primary"
                        android:drawableStart="@android:drawable/ic_menu_agenda"
                        android:drawableTint="#FFFFFF"
                        android:text="Prescriptions" />

                    <!-- AI Assistant Pill Button -->
                    <Button
                        android:id="@+id/ai_assistant_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        style="@style/Widget.HealthAssistant.Button.Primary"
                        android:drawableStart="@android:drawable/ic_menu_edit"
                        android:drawableTint="#FFFFFF"
                        android:text="AI Assistant" />

                    <!-- Emergency Pill Button -->
                    <Button
                        android:id="@+id/emergency_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Widget.HealthAssistant.Button.Primary"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:drawableTint="#FFFFFF"
                        android:text="Emergency" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Wellness Tips Section -->
            <TextView
                android:id="@+id/insights_title"
                style="@style/TextAppearance.HealthAssistant.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="Your Insights"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/quick_actions_scroll" />

            <!-- Wellness Tips Cards with Premium Style -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/insights_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/insights_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>