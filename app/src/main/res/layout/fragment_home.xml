<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".features.home.HomeFragment">

    <!-- Clean white background - no decorative elements needed -->

    <!-- Health Assistant Chat FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/chat_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Open Health Assistant Chat"
        android:src="@drawable/ic_ai_chatbot"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/white"
        app:elevation="6dp"
        app:pressedTranslationZ="12dp" />

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:background="@android:color/transparent"
        android:paddingTop="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:paddingBottom="24dp">

            <!-- Standardized Top Section with Personalized Greeting and Avatar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top_section"
                style="@style/Widget.HealthAssistant.FragmentHeader"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Greeting Text Container - Left Aligned -->
                <LinearLayout
                    android:id="@+id/greeting_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@+id/user_avatar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/user_avatar">

                    <!-- Greeting Text with Username Styling -->
                    <TextView
                        android:id="@+id/greeting_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Good morning, Alex"
                        android:textAppearance="@style/TextAppearance.HealthAssistant.FragmentTitle"
                        android:gravity="start"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Date Text -->
                    <TextView
                        android:id="@+id/date_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saturday, July 12"
                        android:textAppearance="@style/TextAppearance.HealthAssistant.FragmentSubtitle"
                        android:gravity="start"
                        android:elevation="1dp"/>
                </LinearLayout>

                <!-- User Avatar - Right Aligned -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/user_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:clickable="true"
                    android:contentDescription="View profile photo"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:civ_border_color="@color/colorPrimary"
                    app:civ_border_width="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Health Summary Card with HealthCardComponent -->
            <com.example.health_assistant.core.design.components.HealthCardComponent
                android:id="@+id/health_summary_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_margin_standard"
                android:layout_marginEnd="@dimen/ds_margin_standard"
                android:layout_marginTop="-16dp"
                app:healthCardType="primary"
                app:healthCardPadding="@dimen/ds_padding_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/top_section">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/health_summary_title"
                            style="@style/TextAppearance.HealthTypography.Title.Large"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health Overview"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Health Metrics Section with Triple-Ring Progress View -->

                    <!-- Health Metrics Legend - Improved spacing and contrast -->
                    <com.example.health_assistant.widgets.TripleRingProgressView
                        android:id="@+id/triple_ring_progress"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/ds_margin_standard"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/health_summary_title"
                        app:layout_constraintVertical_bias="0.228" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/metrics_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_margin_large"
                        android:background="@drawable/clean_card_background"
                        android:padding="@dimen/ds_padding_medium"
                        app:layout_constraintBottom_toBottomOf="@id/triple_ring_progress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@id/triple_ring_progress"
                        app:layout_constraintTop_toTopOf="@id/triple_ring_progress"
                        app:layout_constraintVertical_bias="0.44">

                        <!-- Steps Metric -->
                        <ImageView
                            android:id="@+id/steps_icon"
                            android:layout_width="@dimen/ds_component_icon_size"
                            android:layout_height="@dimen/ds_component_icon_size"
                            android:contentDescription="Steps"
                            android:src="@drawable/ic_steps"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/progress_orange" />

                        <TextView
                            android:id="@+id/steps_label"
                            style="@style/TextAppearance.HealthTypography.Label.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_padding_small"
                            android:text="Steps"
                            app:layout_constraintBottom_toBottomOf="@id/steps_icon"
                            app:layout_constraintStart_toEndOf="@id/steps_icon"
                            app:layout_constraintTop_toTopOf="@id/steps_icon" />

                        <TextView
                            android:id="@+id/steps_value"
                            style="@style/TextAppearance.HealthTypography.Body.Large"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_margin_standard"
                            android:layout_marginTop="@dimen/ds_spacing_quarter"
                            android:text="0 / 9000 steps"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/steps_icon"
                            app:layout_constraintTop_toBottomOf="@id/steps_icon" />

                        <!-- Calories Metric -->
                        <ImageView
                            android:id="@+id/calories_icon"
                            android:layout_width="@dimen/ds_component_icon_size"
                            android:layout_height="@dimen/ds_component_icon_size"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:contentDescription="Calories"
                            android:src="@drawable/ic_calories"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/steps_value"
                            app:tint="@color/progress_green" />

                        <TextView
                            android:id="@+id/calories_label"
                            style="@style/TextAppearance.HealthTypography.Label.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_padding_small"
                            android:text="Calories"
                            app:layout_constraintBottom_toBottomOf="@id/calories_icon"
                            app:layout_constraintStart_toEndOf="@id/calories_icon"
                            app:layout_constraintTop_toTopOf="@id/calories_icon" />

                        <TextView
                            android:id="@+id/calories_value"
                            style="@style/TextAppearance.HealthTypography.Body.Large"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_margin_standard"
                            android:layout_marginTop="@dimen/ds_spacing_quarter"
                            android:text="0 / 300 kcal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/calories_icon"
                            app:layout_constraintTop_toBottomOf="@id/calories_icon" />

                        <!-- Heart Points Metric -->
                        <ImageView
                            android:id="@+id/heart_points_icon"
                            android:layout_width="@dimen/ds_component_icon_size"
                            android:layout_height="@dimen/ds_component_icon_size"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:contentDescription="Heart Points"
                            android:src="@drawable/ic_workout"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/calories_value"
                            app:tint="@color/progress_blue" />

                        <TextView
                            android:id="@+id/heart_points_label"
                            style="@style/TextAppearance.HealthTypography.Label.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_padding_small"
                            android:text="Heart Points"
                            app:layout_constraintBottom_toBottomOf="@id/heart_points_icon"
                            app:layout_constraintStart_toEndOf="@id/heart_points_icon"
                            app:layout_constraintTop_toTopOf="@id/heart_points_icon" />

                        <TextView
                            android:id="@+id/heart_points_value"
                            style="@style/TextAppearance.HealthTypography.Body.Large"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ds_margin_standard"
                            android:layout_marginTop="@dimen/ds_spacing_quarter"
                            android:text="0 / 50 points"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@id/heart_points_icon"
                            app:layout_constraintTop_toBottomOf="@id/heart_points_icon" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.example.health_assistant.core.design.components.HealthCardComponent>

            <!-- Wellness Tip Card -->
            <com.example.health_assistant.core.design.components.HealthCardComponent
                android:id="@+id/contextual_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_margin_standard"
                android:layout_marginEnd="@dimen/ds_margin_standard"
                android:layout_marginTop="@dimen/ds_margin_standard"
                app:healthCardType="secondary"
                app:healthCardPadding="@dimen/ds_padding_xl"
                android:foreground="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/health_summary_card">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/contextual_title"
                            style="@style/TextAppearance.HealthTypography.Title.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wellness Tip"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@id/contextual_title">


                            <TextView
                                android:id="@+id/contextual_content"
                                style="@style/TextAppearance.HealthTypography.Body.Medium"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Stay hydrated! Aim for 8 glasses of water today." />
                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
            </com.example.health_assistant.core.design.components.HealthCardComponent>

            <!-- My Progress Section -->
            <TextView
                android:id="@+id/my_progress_title"
                style="@style/TextAppearance.HealthTypography.Title.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_padding_xl"
                android:layout_marginTop="@dimen/ds_layout_section_spacing"
                android:text="My Progress"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/contextual_card" />

            <!-- Steps This Week Card -->
            <com.example.health_assistant.core.design.components.HealthCardComponent
                android:id="@+id/steps_this_week_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_margin_standard"
                android:layout_marginTop="@dimen/ds_margin_standard"
                android:layout_marginEnd="@dimen/ds_margin_standard"
                app:healthCardType="primary"
                app:healthCardPadding="@dimen/ds_padding_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/my_progress_title">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/steps_chart_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/steps_chart_title"
                            style="@style/TextAppearance.HealthTypography.Title.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Steps This Week"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Steps Summary Row -->
                        <LinearLayout
                            android:id="@+id/steps_summary_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_padding_small"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/steps_chart_title">

                            <TextView
                                android:id="@+id/total_steps_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: " />

                            <TextView
                                android:id="@+id/total_steps_value"
                                style="@style/TextAppearance.HealthTypography.Body.Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42,350 steps" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/daily_average_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg: " />

                            <TextView
                                android:id="@+id/daily_average_value"
                                style="@style/TextAppearance.HealthTypography.Body.Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6,050/day" />

                        </LinearLayout>

                        <!-- Steps Chart View -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/steps_bar_chart"
                            android:layout_width="0dp"
                            android:layout_height="220dp"
                            android:layout_marginTop="@dimen/ds_padding_small"
                            android:layout_marginBottom="@dimen/ds_padding_small"
                            app:layout_constraintTop_toBottomOf="@+id/steps_summary_row"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintWidth_percent="1.0"
                            android:background="@android:color/transparent" />

                        <!-- Weekly Goal Progress -->
                        <LinearLayout
                            android:id="@+id/weekly_goal_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/steps_bar_chart">

                            <TextView
                                android:id="@+id/weekly_goal_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly Goal Progress" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/weekly_goal_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_padding_small"
                                android:progress="60"
                                app:indicatorColor="@color/progress_orange"
                                app:trackColor="#30FFFFFF"
                                app:trackCornerRadius="@dimen/ds_spacing_half" />

                            <TextView
                                android:id="@+id/weekly_goal_text"
                                style="@style/TextAppearance.HealthTypography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_spacing_half"
                                android:text="42,350 / 70,000 steps (60%)" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.example.health_assistant.core.design.components.HealthCardComponent>

            <!-- Calories This Week Card -->
            <com.example.health_assistant.core.design.components.HealthCardComponent
                android:id="@+id/calories_this_week_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_margin_standard"
                android:layout_marginTop="@dimen/ds_margin_standard"
                android:layout_marginEnd="@dimen/ds_margin_standard"
                app:healthCardType="primary"
                app:healthCardPadding="@dimen/ds_padding_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/steps_this_week_card">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/calories_chart_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/calories_chart_title"
                            style="@style/TextAppearance.HealthTypography.Title.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calories This Week"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/calories_summary_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_padding_small"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/calories_chart_title">

                            <TextView
                                android:id="@+id/total_calories_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: " />

                            <TextView
                                android:id="@+id/total_calories_value"
                                style="@style/TextAppearance.HealthTypography.Body.Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2,100 kcal" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/daily_calories_average_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg: " />

                            <TextView
                                android:id="@+id/daily_calories_average_value"
                                style="@style/TextAppearance.HealthTypography.Body.Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="300 kcal" />
                        </LinearLayout>

                        <!-- Calories Chart View -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/calories_chart"
                            android:layout_width="0dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:background="@android:color/transparent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/calories_summary_row" />

                        <!-- Weekly Goal Progress for Calories -->
                        <LinearLayout
                            android:id="@+id/calories_weekly_goal_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/calories_chart">

                            <TextView
                                android:id="@+id/calories_weekly_goal_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly Goal Progress" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/calories_weekly_goal_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_padding_small"
                                android:progress="70"
                                app:indicatorColor="@color/progress_green"
                                app:trackColor="#30FFFFFF"
                                app:trackCornerRadius="@dimen/ds_spacing_half" />

                            <TextView
                                android:id="@+id/calories_weekly_goal_text"
                                style="@style/TextAppearance.HealthTypography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_spacing_half"
                                android:text="2,100 / 3,000 kcal (70%)" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.example.health_assistant.core.design.components.HealthCardComponent>

            <!-- Heart Points This Week Card -->
            <com.example.health_assistant.core.design.components.HealthCardComponent
                android:id="@+id/heart_points_this_week_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_margin_standard"
                android:layout_marginTop="@dimen/ds_margin_standard"
                android:layout_marginEnd="@dimen/ds_margin_standard"
                app:healthCardType="primary"
                app:healthCardPadding="@dimen/ds_padding_xl"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/calories_this_week_card">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/heart_points_chart_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/heart_points_chart_title"
                            style="@style/TextAppearance.HealthTypography.Title.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Heart Points This Week"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:id="@+id/heart_points_summary_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_padding_small"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/heart_points_chart_title">

                            <TextView
                                android:id="@+id/total_heart_points_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total: " />

                            <TextView
                                android:id="@+id/total_heart_points_value"
                                style="@style/TextAppearance.HealthTypography.Body.Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35 points" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <TextView
                                android:id="@+id/daily_heart_points_average_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Avg: " />

                            <TextView
                                android:id="@+id/daily_heart_points_average_value"
                                style="@style/TextAppearance.HealthTypography.Body.Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 points" />
                        </LinearLayout>

                        <!-- Heart Points Chart View -->
                        <com.github.mikephil.charting.charts.BarChart
                            android:id="@+id/heart_points_chart"
                            android:layout_width="0dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:background="@android:color/transparent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/heart_points_summary_row" />

                        <!-- Weekly Goal Progress for Heart Points -->
                        <LinearLayout
                            android:id="@+id/heart_points_weekly_goal_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ds_margin_standard"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/heart_points_chart">

                            <TextView
                                android:id="@+id/heart_points_weekly_goal_label"
                                style="@style/TextAppearance.HealthTypography.Label.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly Goal Progress" />

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/heart_points_weekly_goal_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_padding_small"
                                android:progress="70"
                                app:indicatorColor="@color/progress_blue"
                                app:trackColor="#30FFFFFF"
                                app:trackCornerRadius="@dimen/ds_spacing_half" />

                            <TextView
                                android:id="@+id/heart_points_weekly_goal_text"
                                style="@style/TextAppearance.HealthTypography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ds_spacing_half"
                                android:text="245 / 350 points (70%)" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.example.health_assistant.core.design.components.HealthCardComponent>

            <!-- Wellness Tips Section -->
            <TextView
                android:id="@+id/insights_title"
                style="@style/TextAppearance.HealthTypography.Title.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_padding_xl"
                android:layout_marginTop="@dimen/ds_layout_section_spacing"
                android:text="Your Insights"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/heart_points_this_week_card" />

            <!-- Wellness Tips Cards with Premium Style -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/insights_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_margin_standard"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_margin_standard"
                android:paddingEnd="@dimen/ds_margin_standard"
                android:paddingBottom="@dimen/ds_padding_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/insights_title" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>