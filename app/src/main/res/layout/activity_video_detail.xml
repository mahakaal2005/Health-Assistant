<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Video Player Container -->
            <FrameLayout
                android:id="@+id/video_player_container"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/black">

                <ImageView
                    android:id="@+id/video_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_heart" />

                <ImageView
                    android:id="@+id/play_button"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circle_button_background"
                    android:src="@drawable/ic_play_arrow"
                    android:tint="@color/white"
                    android:padding="16dp"
                    android:elevation="4dp" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ds_padding_standard">

                <!-- Video Title -->
                <TextView
                    android:id="@+id/video_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_margin_standard"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Title.Large"
                    tools:text="10-Minute Morning Yoga for Better Health" />

                <!-- Video Metadata -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_margin_standard"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/video_expert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium"
                        tools:text="Dr. Maria Rodriguez, Yoga Therapist" />

                    <TextView
                        android:id="@+id/video_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_margin_medium"
                        android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium"
                        tools:text="10:30" />

                    <TextView
                        android:id="@+id/video_difficulty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ds_margin_medium"
                        android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                        tools:text="Beginner" />

                </LinearLayout>

                <!-- Video Category -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/video_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_margin_large"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                    app:chipBackgroundColor="@color/colorChip"
                    app:chipCornerRadius="@dimen/ds_component_card_radius_small"
                    app:chipStrokeWidth="0dp"
                    tools:text="Fitness" />

                <!-- Video Description -->
                <TextView
                    android:id="@+id/video_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_margin_large"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Body.Medium"
                    android:lineSpacingExtra="@dimen/ds_text_line_spacing_medium"
                    tools:text="Start your day with this gentle yoga routine designed to improve flexibility and mental clarity. This beginner-friendly session includes breathing exercises and basic poses." />

                <!-- Video Tags -->
                <TextView
                    android:id="@+id/tags_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_margin_small"
                    android:text="Tags:"
                    android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/video_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ds_margin_large"
                    app:chipSpacing="@dimen/ds_margin_small">

                    <!-- Tags will be added programmatically -->
                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="yoga"
                        android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                        app:chipBackgroundColor="@color/ds_surface_secondary"
                        app:chipCornerRadius="@dimen/ds_component_card_radius_small"
                        app:chipStrokeWidth="0dp"
                        tools:visibility="visible" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="morning routine"
                        android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                        app:chipBackgroundColor="@color/ds_surface_secondary"
                        app:chipCornerRadius="@dimen/ds_component_card_radius_small"
                        app:chipStrokeWidth="0dp"
                        tools:visibility="visible" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_download"
                        style="@style/Widget.HealthAssistant.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/ds_margin_small"
                        android:text="Download"
                        app:icon="@drawable/ic_download" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_share"
                        style="@style/Widget.HealthAssistant.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/ds_margin_small"
                        android:text="Share"
                        app:icon="@drawable/ic_share" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>