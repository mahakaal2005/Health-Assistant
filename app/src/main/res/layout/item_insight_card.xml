<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Background with subtle gradient -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/insight_card_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Top section with icon -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/insight_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#03A9F4" />

                <TextView
                    android:id="@+id/insight_title"
                    style="@style/TextAppearance.HealthAssistant.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Insight Title" />
            </LinearLayout>

            <!-- Content -->
            <TextView
                android:id="@+id/insight_content"
                style="@style/TextAppearance.HealthAssistant.TipText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is where the insight content appears with improved readability and spacing." />

            <!-- Action Button (optional) -->
            <Button
                android:id="@+id/insight_action_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Learn More"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="#03A9F4"
                android:background="?attr/selectableItemBackground"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp" />
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>