<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/health_preferences_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/content_padding_medium"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/corner_radius_large"
    app:cardElevation="@dimen/card_elevation_small">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glassmorphism_card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/content_padding_medium">

            <!-- Section Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:text="@string/health_preferences"
                style="@style/TextAppearance.HealthAssistant.SectionTitle" />

            <!-- Daily Step Goal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Step Goal"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/step_goal_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Adjust daily step goal"
                    android:valueFrom="1000"
                    android:valueTo="20000"
                    android:value="10000"
                    android:stepSize="1000"
                    app:thumbColor="@color/colorPrimaryGradientStart"
                    app:trackColorActive="@color/colorPrimaryGradientStart"
                    app:trackColorInactive="@color/textTertiary" />

                <TextView
                    android:id="@+id/step_goal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="10,000 steps"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Water Intake Goal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Water Intake Goal"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/water_goal_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Adjust daily water intake goal"
                    android:valueFrom="1"
                    android:valueTo="5"
                    android:value="2.5"
                    android:stepSize="0.1"
                    app:thumbColor="@color/stepBlue"
                    app:trackColorActive="@color/stepBlue"
                    app:trackColorInactive="@color/textTertiary" />

                <TextView
                    android:id="@+id/water_goal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="2.5 liters"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Sleep Goal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sleep Goal"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sleep_goal_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="Adjust sleep goal"
                    android:valueFrom="4"
                    android:valueTo="12"
                    android:value="8"
                    android:stepSize="0.5"
                    app:thumbColor="@color/colorPrimaryGradientEnd"
                    app:trackColorActive="@color/colorPrimaryGradientEnd"
                    app:trackColorInactive="@color/textTertiary" />

                <TextView
                    android:id="@+id/sleep_goal_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="8 hours"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/content_padding_small"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:background="@color/glassHighlight" />

            <!-- Section Header: Personalization -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:text="@string/personalization"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- AI Personalization Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI Personalization"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use AI to personalize your health recommendations"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/ai_personalization_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/colorPrimaryGradientStart"
                    app:trackTint="@color/colorPrimaryGradientEnd" />
            </LinearLayout>

            <!-- Language Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_padding_medium"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Language"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/language_dropdown_layout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:boxBackgroundColor="#10FFFFFF"
                    app:boxStrokeColor="@color/colorPrimaryGradientStart"
                    app:endIconTint="@color/colorPrimaryGradientStart"
                    app:startIconTint="@color/colorPrimaryGradientStart">

                    <AutoCompleteTextView
                        android:id="@+id/language_dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="English (US)"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Theme Selection -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App Theme"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/theme_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/theme_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/content_padding_medium"
                        android:buttonTint="@color/colorPrimaryGradientStart"
                        android:checked="true"
                        android:text="Light"
                        android:textColor="@color/textPrimary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/theme_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/content_padding_medium"
                        android:buttonTint="@color/colorPrimaryGradientStart"
                        android:text="Dark"
                        android:textColor="@color/textPrimary" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/theme_system"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/colorPrimaryGradientStart"
                        android:text="System Default"
                        android:textColor="@color/textPrimary" />
                </RadioGroup>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>