<?xml version="1.0" encoding="utf-8"?>
<com.example.health_assistant.core.design.components.HealthCardComponent xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:healthCardType="secondary"
    app:healthCardPadding="@dimen/ds_padding_standard">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Category Icon -->
    <ImageView
        android:id="@+id/categoryIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_medical_category"
        android:contentDescription="Category icon"
        app:tint="?attr/colorOnSurfaceVariant" />

    <!-- Category Name -->
    <TextView
        android:id="@+id/categoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Cardiology" />

    <!-- Prescription Count -->
    <TextView
        android:id="@+id/prescriptionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:background="@drawable/prescription_count_background"
        android:padding="8dp"
        android:minWidth="32dp"
        android:gravity="center"
        tools:text="3" />

</LinearLayout>

</com.example.health_assistant.core.design.components.HealthCardComponent>