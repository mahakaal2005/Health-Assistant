<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.HealthAssistant.Card.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:clickable="true"
    android:contentDescription="Health article card"
    app:strokeColor="@color/ds_primary"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ds_padding_standard">

        <!-- Article Image -->
        <ImageView
            android:id="@+id/imageArticle"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="@dimen/ds_margin_standard"
            android:scaleType="centerCrop"
            android:background="@drawable/card_light_gray"
            android:contentDescription="Article preview image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_heart" />

        <!-- Article Title -->
        <TextView
            android:id="@+id/textArticleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_margin_standard"
            android:textAppearance="@style/TextAppearance.HealthTypography.Body.Large"
            android:maxLines="2"
            android:ellipsize="end"
            android:accessibilityHeading="true"
            android:contentDescription="Article title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageArticle"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Understanding Heart Health: A Complete Guide" />

        <!-- Article Summary -->
        <TextView
            android:id="@+id/textArticleSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_margin_standard"
            android:layout_marginTop="@dimen/ds_margin_small"
            android:textAppearance="@style/TextAppearance.HealthTypography.Body.Medium"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageArticle"
            app:layout_constraintTop_toBottomOf="@id/textArticleTitle"
            tools:text="Learn about the fundamentals of cardiovascular health and how to maintain a healthy heart through lifestyle choices." />

        <!-- Author and Reading Time -->
        <TextView
            android:id="@+id/textArticleAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_margin_standard"
            android:layout_marginTop="@dimen/ds_margin_small"
            android:textAppearance="@style/TextAppearance.HealthTypography.Label.Medium"
            app:layout_constraintEnd_toStartOf="@id/textReadingTime"
            app:layout_constraintStart_toEndOf="@id/imageArticle"
            app:layout_constraintTop_toBottomOf="@id/textArticleSummary"
            tools:text="Dr. Sarah Johnson" />

        <TextView
            android:id="@+id/textReadingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_margin_small"
            android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textArticleSummary"
            tools:text="5 min read" />

        <!-- Category Tag -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chipCategory"
            style="@style/Widget.HealthAssistant.Button.Tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_margin_standard"
            android:minHeight="32dp"
            android:paddingStart="@dimen/ds_padding_medium"
            android:paddingTop="@dimen/ds_padding_small"
            android:paddingEnd="@dimen/ds_padding_medium"
            android:paddingBottom="@dimen/ds_padding_small"
            android:textAppearance="@style/TextAppearance.HealthTypography.Label.Small"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/ds_component_card_radius_small"
            app:strokeWidth="@dimen/ds_border_width_thin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageArticle"
            tools:text="Nutrition" />

        <!-- Credibility Score -->
        <LinearLayout
            android:id="@+id/layoutCredibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_margin_standard"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/chipCategory"
            app:layout_constraintTop_toBottomOf="@id/imageArticle"
            android:layout_marginStart="@dimen/ds_margin_small">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_verified"
                android:tint="@color/success"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/textCredibilityScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.HealthTypography.Caption"
                android:textColor="@color/success"
                tools:text="Verified" />

        </LinearLayout>

        <!-- Progress Bar (for reading progress) -->
        <ProgressBar
            android:id="@+id/progressReading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/ds_margin_standard"
            android:progressTint="@color/colorPrimary"
            android:progressBackgroundTint="@color/colorProgressBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipCategory"
            tools:progress="30" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_margin_standard"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressReading">

            <ImageButton
                android:id="@+id/buttonBookmark"
                android:layout_width="@dimen/ds_component_touch_target"
                android:layout_height="@dimen/ds_component_touch_target"
                android:layout_marginEnd="@dimen/ds_margin_small"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark"
                android:tint="@color/textSecondary"
                android:contentDescription="Bookmark article" />

            <ImageButton
                android:id="@+id/buttonShare"
                android:layout_width="@dimen/ds_component_touch_target"
                android:layout_height="@dimen/ds_component_touch_target"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:tint="@color/textSecondary"
                android:contentDescription="Share article" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>