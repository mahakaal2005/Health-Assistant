<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_state_pressed" />
            <corners android:radius="@dimen/ds_radius_m" />
        </shape>
    </item>
    
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_state_focused" />
            <corners android:radius="@dimen/ds_radius_m" />
            <stroke 
                android:width="2dp"
                android:color="@color/ds_focus_ring" />
        </shape>
    </item>
    
    <!-- Hover state -->
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_state_hover" />
            <corners android:radius="@dimen/ds_radius_m" />
        </shape>
    </item>
    
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/ds_radius_m" />
        </shape>
    </item>
    
</selector>