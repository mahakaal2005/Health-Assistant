<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF"> <!-- Enhanced ripple effect (25% white) -->

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" /> <!-- Matching the pill button radius -->
            <gradient
                android:startColor="#03A9F4"
                android:endColor="#4DD0E1"
                android:angle="45" /> <!-- Gradient from sky blue to teal -->
            <stroke android:color="#4DFFFFFF" android:width="1.5dp" /> <!-- Softer glow border (30% white) -->
        </shape>
    </item>
</ripple>