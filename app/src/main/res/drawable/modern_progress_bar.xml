<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Background progress track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_neutral_200" />
            <corners android:radius="@dimen/ds_progress_radius" />
        </shape>
    </item>
    
    <!-- Progress bar -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/ds_primary_400"
                    android:endColor="@color/ds_primary_600"
                    android:type="linear" />
                <corners android:radius="@dimen/ds_progress_radius" />
            </shape>
        </clip>
    </item>
    
</layer-list>