<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/homeFragment">

    <!-- Global action to navigate to AuthActivity -->
    <activity
        android:id="@+id/authActivity"
        android:name="com.example.health_assistant.auth.AuthActivity"
        android:label="Auth"
        tools:layout="@layout/auth_activity" />

    <action
        android:id="@+id/action_global_to_authActivity"
        app:destination="@id/authActivity"
        app:popUpTo="@id/nav_main"
        app:popUpToInclusive="true" />

    <!-- Global actions for cross-feature navigation -->
    <action
        android:id="@+id/action_global_to_discoverFragment"
        app:destination="@id/discoverFragment"
        app:popUpTo="@id/homeFragment"
        app:popUpToInclusive="false" />

    <action
        android:id="@+id/action_global_to_articleReaderFragment"
        app:destination="@id/articleReaderFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />

    <action
        android:id="@+id/action_global_to_videoPlayerFragment"
        app:destination="@id/videoPlayerFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />

    <action
        android:id="@+id/action_global_to_bookmarksFragment"
        app:destination="@id/bookmarksFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />

    <!-- HOME FRAGMENT - Central Hub -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.health_assistant.features.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <!-- Navigation to secondary screens from Home -->
        <action
            android:id="@+id/action_homeFragment_to_prescriptionsFragment"
            app:destination="@id/prescriptionsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- MAIN NAVIGATION FRAGMENTS -->
    <!-- These fragments use MainActivity's custom navigation logic -->
    <!-- No individual actions needed - handled by bottom navigation -->

    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.example.health_assistant.features.discover.DiscoverFragment"
        android:label="Discover"
        tools:layout="@layout/fragment_discover">

        <!-- Navigation to article reader -->
        <action
            android:id="@+id/action_discoverFragment_to_articleReaderFragment"
            app:destination="@id/articleReaderFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Navigation to video player -->
        <action
            android:id="@+id/action_discoverFragment_to_videoPlayerFragment"
            app:destination="@id/videoPlayerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Navigation to bookmarks -->
        <action
            android:id="@+id/action_discoverFragment_to_bookmarksFragment"
            app:destination="@id/bookmarksFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Cross-feature navigation to Journal for health tracking -->
        <action
            android:id="@+id/action_discoverFragment_to_journalFragment"
            app:destination="@id/journalFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />

        <!-- Navigation to Profile for health preferences -->
        <action
            android:id="@+id/action_discoverFragment_to_profileFragment"
            app:destination="@id/profileFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />

        <!-- Navigation to content list -->
        <action
            android:id="@+id/action_discoverFragment_to_contentListFragment"
            app:destination="@id/contentListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/journalFragment"
        android:name="com.example.health_assistant.features.journal.JournalFragment"
        android:label="Journal"
        tools:layout="@layout/fragment_journal">

        <!-- Navigation to journal detail fragments -->
        <action
            android:id="@+id/action_journalFragment_to_noteDetailFragment"
            app:destination="@id/noteDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_journalFragment_to_activityDetailFragment"
            app:destination="@id/activityDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_journalFragment_to_diaryDetailFragment"
            app:destination="@id/diaryDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.health_assistant.features.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">

        <!-- Navigation to profile-specific screens -->
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- SECONDARY SCREENS -->
    <!-- These maintain normal back navigation to their parent fragments -->

    <fragment
        android:id="@+id/prescriptionsFragment"
        android:name="com.example.health_assistant.features.prescriptions.PrescriptionsFragment"
        android:label="@string/prescriptions_title"
        tools:layout="@layout/fragment_prescriptions" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.health_assistant.features.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.health_assistant.features.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <!-- JOURNAL DETAIL FRAGMENTS -->
    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.health_assistant.features.journal.presentation.NoteDetailFragment"
        android:label="Note Details"
        tools:layout="@layout/fragment_note_detail" />

    <fragment
        android:id="@+id/activityDetailFragment"
        android:name="com.example.health_assistant.features.journal.presentation.ActivityDetailFragment"
        android:label="Activity Details"
        tools:layout="@layout/fragment_activity_detail">
        <argument
            android:name="activityCardId"
            app:argType="long"
            android:defaultValue="0L" />
        <argument
            android:name="activityCardDate"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/diaryDetailFragment"
        android:name="com.example.health_assistant.features.journal.presentation.DiaryDetailFragment"
        android:label="Diary Details"
        tools:layout="@layout/fragment_diary_detail">
        <argument
            android:name="diaryTitle"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="diaryContent"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="diaryId"
            app:argType="long"
            android:defaultValue="0L" />
    </fragment>

    <!-- DISCOVER DETAIL FRAGMENTS -->
    <fragment
        android:id="@+id/contentListFragment"
        android:name="com.example.health_assistant.features.discover.presentation.ContentListFragment"
        android:label="Content List"
        tools:layout="@layout/fragment_content_list">
        <argument
            android:name="contentType"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/articleReaderFragment"
        android:name="com.example.health_assistant.features.discover.presentation.ArticleReaderFragment"
        android:label="Article Reader"
        tools:layout="@layout/fragment_article_reader">
        <argument
            android:name="articleId"
            app:argType="string" />
        <argument
            android:name="contentType"
            app:argType="string"
            android:defaultValue="article" />
        
        <!-- Deep link for sharing articles -->
        <deepLink
            app:uri="healthassistant://discover/article/{articleId}"
            app:action="android.intent.action.VIEW" />
        <deepLink
            app:uri="https://healthassistant.app/discover/article/{articleId}"
            app:action="android.intent.action.VIEW" />
    </fragment>

    <fragment
        android:id="@+id/bookmarksFragment"
        android:name="com.example.health_assistant.features.discover.presentation.BookmarksFragment"
        android:label="Bookmarks"
        tools:layout="@layout/fragment_bookmarks">

        <!-- Navigation to content readers -->
        <action
            android:id="@+id/action_bookmarksFragment_to_articleReaderFragment"
            app:destination="@id/articleReaderFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_bookmarksFragment_to_videoPlayerFragment"
            app:destination="@id/videoPlayerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <!-- Deep link for bookmarks -->
        <deepLink
            app:uri="healthassistant://discover/bookmarks"
            app:action="android.intent.action.VIEW" />
    </fragment>

    <fragment
        android:id="@+id/videoPlayerFragment"
        android:name="com.example.health_assistant.features.discover.presentation.VideoPlayerFragment"
        android:label="Video Player"
        tools:layout="@layout/fragment_video_player">
        <argument
            android:name="videoId"
            app:argType="string" />
        <argument
            android:name="autoPlay"
            app:argType="boolean"
            android:defaultValue="true" />
        
        <!-- Deep link for sharing videos -->
        <deepLink
            app:uri="healthassistant://discover/video/{videoId}"
            app:action="android.intent.action.VIEW" />
        <deepLink
            app:uri="https://healthassistant.app/discover/video/{videoId}"
            app:action="android.intent.action.VIEW" />
    </fragment>

</navigation>