<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Health_Assistant" parent="AppTheme" />

    <!-- Enhanced Full Screen Theme for MainActivity -->
    <style name="Theme.Health_Assistant.FullScreen" parent="AppTheme">
        <!-- Remove action bar and title -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Full screen optimizations -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Edge-to-edge optimizations -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <!-- Smooth animations and transitions -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation.FullScreen</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
    </style>

    <!-- Legacy Theme for MainActivity with custom toolbar (keeping for compatibility) -->
    <style name="Theme.Health_Assistant.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Common style for all app fragments to ensure consistent appearance -->
    <style name="AppFragment">
        <item name="android:background">@color/dashboard_background</item>
    </style>

    <!-- Style for headers in fragments that match the splash screen's gradient -->
    <style name="AppFragment.Header">
        <item name="android:background">@drawable/splash_gradient_background</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">@dimen/content_padding_medium</item>
    </style>

    <!-- Style for content sections in fragments -->
    <style name="AppFragment.Content">
        <item name="android:padding">@dimen/content_padding_medium</item>
    </style>
</resources>