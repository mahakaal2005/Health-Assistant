<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.HealthAssistant" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
    </style>

    <!-- Theme for Splash and Auth Activities (No Action Bar) -->
    <style name="Theme.HealthAssistant.NoActionBar" parent="Theme.HealthAssistant">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Text Appearance Styles -->
    <style name="TextAppearance.HealthAssistant" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.HealthAssistant.Date" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.HealthAssistant.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.HealthAssistant.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="TextAppearance.HealthAssistant.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="TextAppearance.HealthAssistant.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/textTertiary</item>
    </style>

    <!-- Card Styles -->
    <style name="CardView.HealthAssistant" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/cardBackground</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>


    <!-- Window Animation Styles -->
    <style name="WindowAnimation.FullScreen" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <!-- Widget Styles -->
    <!-- Primary Button Style -->
    <style name="Widget.HealthAssistant.Button.Primary" parent="Widget.Material3.Button">
        <!-- Use health green background -->
        <item name="backgroundTint">@color/health_primary</item>
        <!-- Padding: 12dp top/bottom, 24dp left/right -->
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <!-- Elevation: 4dp -->
        <item name="android:elevation">4dp</item>
        <!-- StateListAnimator -->
        <item name="android:stateListAnimator">@xml/button_state_list_animator</item>
        <!-- Minimum height: 56dp -->
        <item name="android:minHeight">56dp</item>
        <!-- Drawable padding: 10dp -->
        <item name="android:drawablePadding">10dp</item>
        <!-- Text size: 16sp -->
        <item name="android:textSize">16sp</item>
        <!-- Font: sans-serif-medium, bold, not all caps -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <!-- Text color: #FFFFFF (white) -->
        <item name="android:textColor">#FFFFFF</item>
        <!-- Letter spacing: 0.02 -->
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Secondary Button Style -->
    <style name="Widget.HealthAssistant.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <!-- Use health green outline -->
        <item name="strokeColor">@color/health_primary</item>
        <item name="strokeWidth">2dp</item>
        <!-- Padding: 12dp top/bottom, 24dp left/right -->
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <!-- Minimum height: 56dp -->
        <item name="android:minHeight">56dp</item>
        <!-- Drawable padding: 10dp -->
        <item name="android:drawablePadding">10dp</item>
        <!-- Text size: 16sp -->
        <item name="android:textSize">16sp</item>
        <!-- Font: sans-serif-medium, bold, not all caps -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <!-- Text color: health green -->
        <item name="android:textColor">@color/health_primary</item>
        <!-- Letter spacing: 0.02 -->
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Tertiary Button Style -->
    <style name="Widget.HealthAssistant.Button.Tertiary" parent="Widget.Material3.Button.TextButton">
        <!-- Padding: 12dp top/bottom, 24dp left/right -->
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <!-- Minimum height: 56dp -->
        <item name="android:minHeight">56dp</item>
        <!-- Drawable padding: 10dp -->
        <item name="android:drawablePadding">10dp</item>
        <!-- Text size: 16sp -->
        <item name="android:textSize">16sp</item>
        <!-- Font: sans-serif-medium, bold, not all caps -->
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <!-- Text color: health green -->
        <item name="android:textColor">@color/health_primary</item>
        <!-- Letter spacing: 0.02 -->
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.HealthAssistant.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/text_input_background</item>
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxStrokeWidth">@dimen/ds_border_width_thin</item>
        <item name="boxStrokeWidthFocused">@dimen/ds_border_width_medium</item>
        <item name="hintTextColor">@color/textSecondary</item>
        <item name="android:textColorHint">@color/text_input_box_stroke_default</item>
        <item name="errorTextColor">@color/ds_error</item>
        <item name="errorIconTint">@color/ds_error</item>
        <item name="helperTextTextAppearance">@style/TextAppearance.HealthTypography.Caption</item>
        <item name="errorTextAppearance">@style/TextAppearance.HealthTypography.Caption</item>
        <item name="boxCornerRadiusTopStart">@dimen/ds_component_card_radius_small</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_component_card_radius_small</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_component_card_radius_small</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_component_card_radius_small</item>
    </style>

    <style name="Widget.HealthAssistant.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Success state TextInputLayout for validation feedback -->
    <style name="Widget.HealthAssistant.TextInputLayout.Success" parent="Widget.HealthAssistant.TextInputLayout">
        <item name="boxStrokeColor">@color/ds_success</item>
        <item name="hintTextColor">@color/ds_success</item>
        <item name="helperTextTextColor">@color/ds_success</item>
    </style>



    <!-- Additional Text Appearance Styles -->
    <style name="TextAppearance.HealthAssistant.Greeting" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthAssistant.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthAssistant.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthAssistant.TipText" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Health-focused Typography Styles -->
    <style name="TextAppearance.Health.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/health_dark</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Health.Headline2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Health.Accent" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/health_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Health.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary_dark</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.Health.Body2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary_dark</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Custom Toolbar Theme for Diary Detail -->
    <style name="ToolbarTheme" parent="ThemeOverlay.MaterialComponents.Toolbar.Primary">
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorPrimary">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="actionMenuTextColor">@android:color/black</item>
        <item name="colorControlNormal">@android:color/black</item>
    </style>

    <!-- Custom Popup Menu Theme for white background with black text -->
    <style name="PopupMenuTheme" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="android:popupBackground">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="colorOnSurface">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
    </style>

    <!-- Bottom Navigation Styles -->
    <style name="Widget.HealthAssistant.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/ds_surface_primary</item>
        <item name="android:elevation">@dimen/ds_elevation_low</item>
        <item name="android:minHeight">@dimen/ds_component_touch_target</item>
        <item name="itemIconTint">@color/bottom_nav_item_selector</item>
        <item name="itemTextColor">@color/bottom_nav_item_selector</item>
        <item name="itemIconSize">@dimen/ds_component_icon_size</item>
        <item name="itemPaddingTop">@dimen/ds_padding_small</item>
        <item name="itemPaddingBottom">@dimen/ds_padding_small</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Standardized Fragment Header Styles -->
    <style name="Widget.HealthAssistant.FragmentHeader" parent="@android:style/Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/ds_surface_primary</item>
        <item name="android:elevation">@dimen/ds_elevation_low</item>
        <item name="android:paddingStart">@dimen/ds_padding_xl</item>
        <item name="android:paddingTop">@dimen/ds_padding_medium</item>
        <item name="android:paddingEnd">@dimen/ds_padding_xl</item>
        <item name="android:paddingBottom">@dimen/ds_padding_medium</item>
    </style>

    <style name="TextAppearance.HealthAssistant.FragmentTitle" parent="TextAppearance.Health.Headline1">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthAssistant.FragmentSubtitle" parent="TextAppearance.Health.Body1">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginTop">@dimen/ds_margin_xs</item>
    </style>

    <!-- HealthCardComponent Design System Tokens -->
    <!-- Primary Card Component - Main content display -->
    <style name="Widget.HealthAssistant.Card.Primary" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ds_surface_primary</item>
        <item name="cardCornerRadius">@dimen/ds_component_card_radius</item>
        <item name="cardElevation">@dimen/ds_elevation_low</item>
        <item name="android:layout_margin">@dimen/ds_margin_small</item>
        <item name="contentPadding">@dimen/ds_padding_standard</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Secondary Card Component - Contextual information -->
    <style name="Widget.HealthAssistant.Card.Secondary" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/ds_surface_secondary</item>
        <item name="cardCornerRadius">@dimen/ds_component_card_radius</item>
        <item name="strokeColor">@color/ds_outline</item>
        <item name="strokeWidth">@dimen/ds_border_width_thin</item>
        <item name="android:layout_margin">@dimen/ds_margin_small</item>
        <item name="contentPadding">@dimen/ds_padding_standard</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Elevated Card Component - High emphasis content -->
    <style name="Widget.HealthAssistant.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/ds_surface_primary</item>
        <item name="cardCornerRadius">@dimen/ds_component_card_radius</item>
        <item name="cardElevation">@dimen/ds_elevation_medium</item>
        <item name="android:layout_margin">@dimen/ds_margin_small</item>
        <item name="contentPadding">@dimen/ds_padding_standard</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- HealthTypography Design System Tokens -->
    <!-- Title Typography Tokens -->
    <style name="TextAppearance.HealthTypography.Title.Large" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.HealthTypography.Title.Medium" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthTypography.Title.Small" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body Typography Tokens -->
    <style name="TextAppearance.HealthTypography.Body.Large" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">@dimen/ds_text_line_spacing_medium</item>
    </style>

    <style name="TextAppearance.HealthTypography.Body.Medium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingExtra">@dimen/ds_text_line_spacing_small</item>
    </style>

    <style name="TextAppearance.HealthTypography.Body.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Label Typography Tokens -->
    <style name="TextAppearance.HealthTypography.Label.Large" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthTypography.Label.Medium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.HealthTypography.Label.Small" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Caption Typography Tokens -->
    <style name="TextAppearance.HealthTypography.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ds_text_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

</resources>